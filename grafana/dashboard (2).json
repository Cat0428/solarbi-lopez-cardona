      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * count(*) / NULLIF(\n         EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) / 300\n         * (SELECT count(*) FROM dwh.dim_dispositivo WHERE dispositivo_id IN (${dispositivo})), 0) AS \"% válidos\"\nFROM silver.lectura_5min\nWHERE $__timeFilter(ts)\n  AND dispositivo_id IN (${dispositivo})",
          "refId": "A"
        }
      ],
      "title": "Datos válidos (%)",
      "type": "stat"
    },
