      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(f.energia_kwh) AS \"Energía (kWh)\"\nFROM dwh.fact_energia_dia f\nJOIN dwh.dim_fecha d       USING (fecha_key)\nJOIN dwh.dim_dispositivo dd USING (dispositivo_key)\nWHERE d.fecha >= ($__timeFrom()::timestamptz AT TIME ZONE 'America/Bogota')::date\n  AND d.fecha <  ($__timeTo()::timestamptz   AT TIME ZONE 'America/Bogota')::date\n  AND dd.dispositivo_id IN (${dispositivo})",
          "refId": "A"
        }
      ],
      "title": "Energía del día (Gold, kWh)",
      "type": "stat"
    },
    {
