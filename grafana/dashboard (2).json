          "rawSql": "SELECT count(*) AS \"Lecturas en falla\"\nFROM silver.lectura_5min\nWHERE $__timeFilter(ts)\n  AND dispositivo_id IN (${dispositivo})\n  AND p_ac_kw <= 0\n  AND (ts AT TIME ZONE 'America/Bogota')::time BETWEEN '09:00' AND '15:00'",
