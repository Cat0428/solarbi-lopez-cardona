# Copie este archivo como .env y cambie las contraseñas.
# .env está en .gitignore: NUNCA se sube a GitHub.

# PostgreSQL (usuario dueño de la base; lo usa el ETL)
POSTGRES_USER=solarbi
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=solarbi
PGHOST=localhost
PGPORT=5432

# Rol de solo lectura para Grafana y Power BI
BI_LECTOR_PASSWORD=cambie-esta-otra-clave

# Administrador de Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambie-tambien-esta
GRAFANA_PORT=3000
