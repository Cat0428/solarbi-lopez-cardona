# Los scripts que se ejecutan dentro de contenedores Linux deben tener fin de línea LF
# aunque el repositorio se clone en Windows (si no: "bad interpreter: /bin/bash^M").
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.py    text eol=lf
*.sql   text eol=lf
*.env   text eol=lf
*.ps1   text eol=crlf
