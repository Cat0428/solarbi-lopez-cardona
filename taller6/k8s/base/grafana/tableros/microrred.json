    {
      "id": 1,
      "type": "stat",
      "title": "SOC de la batería",
      "description": "Último estado de carga reportado por cada inversor. Rojo por debajo del umbral de la alerta (20 %).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (inversor_id) ts AS \"time\", 'Inversor ' || inversor_id AS inversor, soc_pct AS \"SOC\"\nFROM silver.lectura_1min\nWHERE inversor_id IN ($inversor) AND ts > now() - interval '1 day'\nORDER BY inversor_id, ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Potencia instantánea",
      "description": "Promedio del último minuto. Batería positiva = descarga hacia la carga; negativa = se está cargando.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (inversor_id) ts AS \"time\", 'Inversor ' || inversor_id AS inversor, pv_potencia_w AS \"Solar\", carga_potencia_w AS \"Carga\", red_potencia_w AS \"Red\", bat_potencia_w AS \"Batería (+desc / −carga)\"\nFROM silver.lectura_1min\nWHERE inversor_id IN ($inversor) AND ts > now() - interval '1 day'\nORDER BY inversor_id, ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Minutos sin datos",
      "description": "Tiempo desde la última lectura. Más de 5 min dispara la alerta de pérdida de comunicación.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 'Inversor ' || i AS inversor,\n       coalesce(extract(epoch FROM now() - max(l.ts)) / 60, 9999) AS \"min sin datos\"\nFROM unnest(ARRAY[$inversor]::int[]) AS i  -- Grafana entrega la variable como texto\nLEFT JOIN silver.lectura_1min l ON l.inversor_id = i AND l.ts > now() - interval '1 day'\nGROUP BY i ORDER BY i"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Datos válidos (periodo)",
      "description": "Lecturas válidas / lecturas recibidas en el rango de tiempo elegido.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100.0 * sum(n_lecturas) / nullif(sum(n_recibidas), 0) AS \"% válidos\"\nFROM silver.lectura_1min\nWHERE $__timeFilter(ts) AND inversor_id IN ($inversor)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      }
    },
    {
