    {
      "id": 5,
      "type": "timeseries",
      "title": "Flujos de potencia por inversor (W)",
      "description": "De dónde viene la energía (solar, red, batería) y a dónde va (carga), minuto a minuto.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\",\n       'Inv ' || inversor_id || ' · solar' AS metric, pv_potencia_w AS value\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nUNION ALL\nSELECT ts, 'Inv ' || inversor_id || ' · carga', carga_potencia_w\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nUNION ALL\nSELECT ts, 'Inv ' || inversor_id || ' · red', red_potencia_w\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nUNION ALL\nSELECT ts, 'Inv ' || inversor_id || ' · batería', bat_potencia_w\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
