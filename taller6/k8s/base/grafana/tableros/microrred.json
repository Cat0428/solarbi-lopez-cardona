    {
      "id": 7,
      "type": "timeseries",
      "title": "Estado de carga (SOC)",
      "description": "La línea roja es el umbral de batería baja (20 %).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", 'Inversor ' || inversor_id AS metric, soc_pct AS value\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            },
            "lineWidth": 2,
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Energía del periodo por origen (kWh)",
      "description": "Balance energético del rango elegido: solar + batería + red ≈ consumo + pérdidas del inversor.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 'Inversor ' || inversor_id AS inversor,\n       sum(pv_energia_wh) / 1000 AS \"Solar\",\n       sum(bat_desc_energia_wh) / 1000 AS \"Batería (descarga)\",\n       sum(red_energia_wh) / 1000 AS \"Red\",\n       sum(carga_energia_wh) / 1000 AS \"Consumo de la carga\"\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nGROUP BY inversor_id ORDER BY inversor_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "inversor",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "showValue": "auto",
        "groupWidth": 0.8,
        "barWidth": 0.9
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Red pública y temperatura del inversor",
      "description": "Voltaje de red (V) y temperatura interna (°C, temper3).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "microrred-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "microrred-pg"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", 'Inv ' || inversor_id || ' · V red' AS metric, red_voltaje_v AS value\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nUNION ALL\nSELECT ts, 'Inv ' || inversor_id || ' · °C inversor', temp_inversor_c\nFROM silver.lectura_1min WHERE $__timeFilter(ts) AND inversor_id IN ($inversor)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": 120000,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*°C.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*V red.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "volt"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
