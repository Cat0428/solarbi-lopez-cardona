# Parámetros NO sensibles de la solución → ConfigMap "microrred-parametros".
# Cambiar un valor:  editar este archivo  →  kubectl apply -k k8s/overlays/demo
# El simulador (CronJob) lo toma en su siguiente corrida; el ETL en la siguiente carga.
# No hace falta reconstruir ninguna imagen.

# Tiempo
ZONA_SITIO=Asia/Shanghai
MUESTREO_S=12
MAX_DT_S=120

# Umbrales de eventos operativos (capa Gold)
SOC_BAJO_PCT=20
TEMP_ALTA_C=60
HUECO_MIN=10

# Características físicas y económicas
CAPACIDAD_PV_KWP=6.24
TARIFA_COP_KWH=930

# Simulador de streaming
SIM_ZONA_RELOJ=America/Bogota
SIM_MAX_MINUTOS=30
SIM_MINUTOS_INICIALES=180
SIM_ANOMALIA_CADA_MIN=60
SIM_ANOMALIA_DURACION_MIN=6
SIM_INVERSOR_ANOMALIA=2
SIM_SOC_ANOMALIA=12
SIM_RETENCION_HORAS=48
