# Copie este archivo como credenciales.env y cambie las contraseñas.
# credenciales.env está en .gitignore: NUNCA se sube a GitHub.
# - docker compose lo lee con env_file.
# - scripts/up crea con él el Secret "microrred-credenciales" de Kubernetes.
POSTGRES_USER=microrred
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=microrred
BI_LECTOR_PASSWORD=cambie-esta-otra-clave
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=cambie-tambien-esta
