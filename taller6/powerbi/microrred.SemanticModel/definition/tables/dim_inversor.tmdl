	partition dim_inversor = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema="gold", Item="dim_inversor"]}[Data],
				    Resultado = Table.AddColumn(Datos, "version_config", each [nombre] & " · salida " & Text.From([prioridad_salida]) & " / carga " & Text.From([prioridad_carga]) & " (desde " & Date.ToText([vigente_desde], "yyyy-MM-dd") & ")", type text)
				in
				    Resultado

