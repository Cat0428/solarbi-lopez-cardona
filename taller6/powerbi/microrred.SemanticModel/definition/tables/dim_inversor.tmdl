/// SCD tipo 2: una fila por versión de configuración del inversor (tabla settings).
table dim_inversor
	lineageTag: 17eccbdb-381b-45f9-ab4f-c845c4123c88

	column inversor_key
		dataType: int64
		isHidden
		lineageTag: 76cdd117-dbf7-4123-b755-6da9ade9bf46
		sourceColumn: inversor_key

	column inversor_id
